[Unit]
Description=PaperTok vector database (shared-memory server)
After=network.target

[Service]
User=papertok
WorkingDirectory=/opt/papertok
ExecStart=/opt/papertok/bin/vecdb serve --index data/index.bin --shm /dev/shm/papertok
Restart=always
RestartSec=1
# The index is mmapped; let it stay resident.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
